# Optional: build/dev configuration
# Remove or comment out variables you do not want baked into local builds.
# Do not add server-side secrets to this file.

# Optional: signed macOS builds (Touch ID / preview passkeys).
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
# T3CODE_PASSKEY_RP_DOMAINS=relay.example.com

# Optional: default self-hosted relay URL (clients can also set this at runtime in Settings).
# T3CODE_RELAY_URL=

# Optional: hosted app origin.
# T3CODE_HOSTED_APP_URL=https://relay.example.com

